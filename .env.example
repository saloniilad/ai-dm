# Copy this file to .env and set only the values you need.
# Values shown here are the application defaults.

# AI backend: mock | anthropic | openai | local
DM_BACKEND=mock

# Anthropic settings
# ANTHROPIC_API_KEY=
# DM_MODEL=claude-sonnet-5-5

# OpenAI-compatible server settings (for vLLM, Ollama, llama.cpp, or another server)
# DM_OPENAI_BASE_URL=http://localhost:8000/v1
# DM_OPENAI_API_KEY=none

# Local LoRA settings
# DM_ADAPTER_PATH=models/dm-lora
# DM_BASE_MODEL=Qwen/Qwen2.5-1.5B-Instruct

# Retrieval settings: 1 enables the feature, 0 disables it
DM_DENSE=0
DM_RERANK=0

# Persistent sessions and generated data
DM_DATA_DIR=data

# Optional JSONL fine-tuning dataset output
# DM_LOG_DATASET=data/dataset/live.jsonl

# Discord bot token
# DISCORD_TOKEN=
